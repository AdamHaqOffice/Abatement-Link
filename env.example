VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Netlify Function-only env vars. Set these in Netlify, not in public client code.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
DEVICE_INGEST_SECRET=choose-a-long-random-secret

VITE_SUPPORT_PORTAL_URL=https://abatementpartnersupport.freshdesk.com/support/home
VITE_MONSUITE_URL=https://monsuite.netlify.app

# Real phone/browser push notifications. VITE_VAPID_PUBLIC_KEY is public; VAPID_PRIVATE_KEY stays server-side only.
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:support@abatement.ca
